# ============================================================================
# URL SHORTENER - ENVIRONMENT VARIABLES
# ============================================================================
# Single .env at the repo root, shared by backend/ and frontend/.
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!
# ============================================================================

# DATABASE CONFIGURATION
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:password@localhost:5432/url-shortener?schema=public"

# BACKEND SERVER
PORT=3000
NODE_ENV="DEVELOPMENT"
BASE_URL="http://localhost:3000/shortUrl"

# KAFKA
KAFKA_BROKER=localhost:9092

# FRONTEND (Vite)
# Only variables prefixed with VITE_ are exposed to client-side code.
# VITE_API_URL="http://localhost:3000"
