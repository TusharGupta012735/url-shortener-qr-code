# ============================================================================
# URL SHORTENER - ENVIRONMENT VARIABLES
# ============================================================================
# Single .env at the repo root, shared by backend/ and frontend/.
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!
# ============================================================================

# DATABASE CONFIGURATION
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:password@localhost:5432/url-shortener?schema=public"

# BACKEND SERVER
PORT=3000
NODE_ENV="development"
BASE_URL="http://localhost:3000/shortUrl"

# KAFKA
KAFKA_BROKER=localhost:9094

# DOCKER COMPOSE
# Used by docker-compose to initialize the Postgres container.
# Keep these in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=url-shortener

# FRONTEND (Vite)
# Only variables prefixed with VITE_ are exposed to client-side code.
# Which build this is - shown as a small badge in the UI.
VITE_APP_ENV=development
# Base URL of the backend API. Point this at your deployed Render backend
# (and set the matching value in Vercel's project env vars) for preprod/production.
VITE_API_URL="http://localhost:3000"
